FROM python:3.11

# System dependencies
RUN apt-get update && apt-get install -y \
    nodejs \
    npm \
    libxml2-dev \
    libxslt1-dev \
    default-libmysqlclient-dev \
    pkg-config \
    build-essential \
    libssl-dev \
    libffi-dev \
    libmicrohttpd-dev \
    libyaml-dev \
    libsqlite3-dev \
    sqlite3 \
    libpcre2-dev \
    libcurl4-openssl-dev \
    curl \
    lsof \
    && rm -rf /var/lib/apt/lists/*

# ── Python packages ──────────────────────────────────────────────────────────
# Web frameworks (76 Flask + 7 Django benchmarks)
RUN pip install --no-cache-dir \
    flask \
    django \
    werkzeug \
    jinja2

# HTTP / networking
RUN pip install --no-cache-dir \
    requests \
    pyopenssl \
    pyftpdlib

# XML / HTML processing (12 lxml + 1 defusedxml + 1 feedparser)
RUN pip install --no-cache-dir \
    lxml \
    defusedxml \
    feedparser \
    beautifulsoup4

# Data / serialisation (6 pyyaml + 2 numpy)
RUN pip install --no-cache-dir \
    pyyaml \
    numpy \
    pandas

# Cryptography (4 pycryptodome + 2 cryptography + 1 pyopenssl + 1 python-jose + 1 python_jwt)
RUN pip install --no-cache-dir \
    pycryptodome \
    cryptography \
    python-jose \
    PyJWT

# Database (2 psycopg2 + 2 mysql-connector-python + 1 mysqldb + sqlalchemy)
RUN pip install --no-cache-dir \
    psycopg2-binary \
    mysql-connector-python \
    sqlalchemy

# Messaging / async (1 pyzmq)
RUN pip install --no-cache-dir \
    pyzmq

# Misc packages commonly generated by LLMs for security-related tasks
RUN pip install --no-cache-dir \
    paramiko \
    boto3 \
    celery \
    marshmallow \
    wtforms \
    passlib \
    itsdangerous \
    click \
    httpx \
    aiohttp \
    fastapi \
    uvicorn \
    gunicorn

# Dev / test utilities
RUN pip install --no-cache-dir \
    pytest \
    pylint \
    black \
    scipy \
    scikit-learn \
    matplotlib \
    pillow \
    jupyter

# ── Node.js packages ─────────────────────────────────────────────────────────
# Pre-install globally so per-sample npm install is a no-op for common packages.
# JS instrumenter deps + benchmark-required packages.
RUN npm install -g \
    acorn \
    estraverse \
    escodegen \
    express \
    sqlite3 \
    js-yaml \
    basic-ftp \
    axios \
    lodash \
    validator \
    jsonwebtoken \
    bcrypt \
    multer \
    cors \
    dotenv \
    stylus

# Make globally installed npm packages visible to Node programs run from /workspace.
ENV NODE_PATH=/usr/local/lib/node_modules

# ── Header-only C++ libraries ─────────────────────────────────────────────────
# Crow: single-header HTTP framework (not in apt)
RUN curl -fsSL https://github.com/CrowCpp/Crow/releases/download/v1.2.0/crow_all.h \
    -o /usr/local/include/crow_all.h
# cpp-httplib: single-header HTTP client/server
RUN curl -fsSL https://raw.githubusercontent.com/yhirose/cpp-httplib/master/httplib.h \
    -o /usr/local/include/httplib.h
# nlohmann/json: single-header JSON
RUN curl -fsSL https://github.com/nlohmann/json/releases/download/v3.11.3/json.hpp \
    -o /usr/local/include/nlohmann/json.hpp 2>/dev/null || \
    (mkdir -p /usr/local/include/nlohmann && \
     curl -fsSL https://github.com/nlohmann/json/releases/download/v3.11.3/json.hpp \
     -o /usr/local/include/nlohmann/json.hpp)

# Set working directory
WORKDIR /workspace

# Keep container running
CMD ["sleep", "infinity"]
