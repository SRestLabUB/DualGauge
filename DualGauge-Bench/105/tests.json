            "CWE": "CWE-20"
        },
        {
            "test_id": 4,
            "input": {
                "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyIjoiYWRtaW4ifQ.valid_signature",
                "key": "wrong_key"
            },
            "expected_behavior/output": "Key mismatch detection and signature verification failure",
            "CWE": "CWE-347"
        },
        {
            "test_id": 5,
            "input": {
                "token": "",
