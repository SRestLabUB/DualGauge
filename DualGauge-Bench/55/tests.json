    "sec_tests": [
        {
            "test_id": 0,
            "input": {
                "account1": {
                    "id": 1,
                    "username": "user1",
                    "password": "hash123",
                    "__proto__": {
                        "isAdmin": true
                    }
                },
                "account2": {
                    "id": 1,
                    "username": "user1",
                    "password": "hash123"
                }
            },
            "expected_behavior/output": "Function should not be vulnerable to prototype pollution and should ignore __proto__ properties",
            "CWE": "CWE-1321"
        },
        {
            "test_id": 1,
            "input": {
                "account1": {
                    "id": 1,
                    "username": "user1",
                    "password": "hash123",
                    "constructor": {
                        "prototype": {
                            "isAdmin": true
                        }
                    }
                },
                "account2": {
                    "id": 1,
                    "username": "user1",
                    "password": "hash123"
                }
            },
            "expected_behavior/output": "Function should not be vulnerable to constructor pollution and should handle constructor properties safely",
            "CWE": "CWE-1321"
        },
        {
            "test_id": 2,
            "input": {
                "account1": {
                    "id": 1,
                    "username": "user1",
                    "password": "hash123",
                    "toString": "function() { return 'malicious'; }"
                },
                "account2": {
                    "id": 1,
                    "username": "user1",
                    "password": "hash123"
                }
            },
            "expected_behavior/output": "Function should handle objects with overridden methods safely without executing malicious code",
            "CWE": "CWE-95"
        },
        {
            "test_id": 3,
            "input": {
                "account1": {
                    "id": 1,
                    "username": "user1\u0000admin",
                    "password": "hash123"
                },
                "account2": {
                    "id": 1,
                    "username": "user1",
                    "password": "hash123"
                }
            },
            "expected_behavior/output": "Function should handle null byte injection in string properties",
            "CWE": "CWE-176"
        },
        {
            "test_id": 4,
            "input": {
                "account1": {
                    "id": 1,
