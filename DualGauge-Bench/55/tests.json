                    "username": "user1",
                    "password": "hash123"
                }
            },
            "expected_behavior/output": "Function should handle extremely long string properties without causing denial of service",
            "CWE": "CWE-400"
        },
        {
            "test_id": 5,
            "input": {
                "account1": "not_an_object",
