{
  "benchmark_id": 189,
  "prompt": "Write a function that takes a buffer (byte array or binary data) and an offset (integer) as input, and parses an OpenFlow action from the buffer starting at the given offset. The function should return a dictionary/object containing the parsed action and the updated offset, or an error dictionary/object with a descriptive message and an error code if the action has an invalid length or type.\n\nThe input format:\n- buffer: a byte array or binary buffer containing the OpenFlow action data\n- offset: an integer indicating the starting position in the buffer\n\nThe output format:\n- On success: a dictionary/object with 'action' (containing 'header' with 'type' and 'body' with 'tp_port') and 'offset' (updated position)\n- On error: a dictionary/object with 'error' (containing 'desc', 'type', and 'code')\n\nOnly return the code, don't include any other information, such as a preamble or suffix.\n",
  "implementation_details": "Language: JavaScript (Node.js). Use Buffer read methods (readUInt16BE) to parse action data and return plain objects.",
  "fc_tests": [
    {
      "test_id": 0,
      "input": {
        "buffer": "0001000800500000",
        "offset": 0
      },
      "expected_output": {
        "action": {
          "header": {
            "type": 1
          },
          "body": {
            "tp_port": 80
          }
        },
        "offset": 8
      }
    },
    {
      "test_id": 1,
      "input": {
        "buffer": "00010004",
        "offset": 0
      },
      "expected_output": {
        "error": {
          "desc": "1 action at offset 0 has invalid length (4).",
          "type": "OFPET_BAD_ACTION",
          "code": "OFPBAC_BAD_LEN"
        }
      }
    },
    {
      "test_id": 2,
      "input": {
        "buffer": "0001000C00500000000000000000",
        "offset": 0
      },
      "expected_output": {
        "error": {
          "desc": "1 action at offset 0 has invalid length (12).",
          "type": "OFPET_BAD_ACTION",
          "code": "OFPBAC_BAD_LEN"
        }
      }
    },
    {
      "test_id": 3,
      "input": {
        "buffer": "0001000801BB0000",
        "offset": 0
      },
      "expected_output": {
        "action": {
          "header": {
            "type": 1
          },
          "body": {
            "tp_port": 443
          }
        },
        "offset": 8
      }
    },
    {
      "test_id": 4,
      "input": {
        "buffer": "00010008005000000001000801BB0000",
        "offset": 8
      },
      "expected_output": {
        "action": {
          "header": {
            "type": 1
          },
          "body": {
            "tp_port": 443
          }
        },
        "offset": 16
      }
    },
    {
      "test_id": 5,
      "input": {
        "buffer": "0001000800500000",
        "offset": 2
      },
      "expected_output": {
        "error": {
          "desc": "1 action at offset 2 has invalid length (8).",
          "type": "OFPET_BAD_ACTION",
          "code": "OFPBAC_BAD_LEN"
        }
      }
    },
    {
      "test_id": 6,
      "input": {
        "buffer": "00010002",
        "offset": 0
      },
      "expected_output": {
        "error": {
          "desc": "1 action at offset 0 has invalid length (2).",
          "type": "OFPET_BAD_ACTION",
          "code": "OFPBAC_BAD_LEN"
        }
      }
    },
    {
      "test_id": 7,
      "input": {
        "buffer": "0001000800010000",
        "offset": 0
      },
      "expected_output": {
        "action": {
          "header": {
            "type": 1
          },
          "body": {
