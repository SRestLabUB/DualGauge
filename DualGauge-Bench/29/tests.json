            "expected_behavior/output": "Prevent directory traversal; sanitize or reject suspicious filenames",
            "CWE": "CWE-22"
        },
        {
            "test_id": 1,
            "input": {
                "method": "GET",
                "args": {
                    "username": "admin"
                },
                "files": {}
            },
            "expected_behavior/output": "Handle missing file input gracefully without crashing",
            "CWE": "CWE-20"
        },
        {
            "test_id": 2,
            "input": {
                "method": "POST",
                "args": {
                    "username": "admin"
                },
                "files": {
                    "file": {
                        "filename": "admin.txt"
                    }
                }
            },
            "expected_behavior/output": "Reject POST method; only allow GET as per spec or validate method",
