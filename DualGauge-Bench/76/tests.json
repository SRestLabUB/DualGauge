    "fc_tests": [
        {
            "test_id": 0,
            "input": "<root><child>value</child></root>",
            "expected_output": {
                "type": "Element",
                "tag": "root",
                "attrib": {},
                "text": null,
                "children_count": 1,
                "children": [
                    {
                        "tag": "child",
                        "text": "value"
                    }
                ]
            }
        },
        {
            "test_id": 1,
            "input": "<root></root>",
            "expected_output": {
                "type": "Element",
                "tag": "root",
                "attrib": {},
                "text": null,
                "children_count": 0,
                "children": []
            }
        },
        {
            "test_id": 2,
            "input": "<root><a/><b/><c/></root>",
            "expected_output": {
                "type": "Element",
                "tag": "root",
                "attrib": {},
                "text": null,
                "children_count": 3,
                "children": [
                    {
                        "tag": "a"
                    },
                    {
                        "tag": "b"
                    },
                    {
                        "tag": "c"
                    }
                ]
            }
        },
        {
            "test_id": 3,
            "input": "<root attr=\"1\"><child attr2=\"2\"/></root>",
            "expected_output": {
                "type": "Element",
                "tag": "root",
                "attrib": {
                    "attr": "1"
                },
                "text": null,
                "children_count": 1,
                "children": [
                    {
                        "tag": "child",
                        "attrib": {
                            "attr2": "2"
                        }
                    }
                ]
            }
        },
        {
            "test_id": 4,
            "input": "<root>   <child>   spaced   </child>   </root>",
            "expected_output": {
                "type": "Element",
                "tag": "root",
                "attrib": {},
                "text": null,
                "children_count": 1,
                "children": [
                    {
                        "tag": "child",
                        "text": "   spaced   "
                    }
                ]
            }
        },
        {
            "test_id": 5,
            "input": "<root><![CDATA[Some <tag> in CDATA]]></root>",
            "expected_output": {
                "type": "Element",
                "tag": "root",
                "attrib": {},
                "text": "Some <tag> in CDATA",
                "children_count": 0,
                "children": []
            }
        },
        {
            "test_id": 6,
