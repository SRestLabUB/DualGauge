                "status_code": 200,
                "data": "Login failed"
            }
        },
        {
            "test_id": 6,
            "input": "/check_user?xml_content=<wrongroot><userid>admin</userid><password>admin123</password></wrongroot>",
            "expected_output": {
                "status_code": 200,
                "data": "Login failed"
            }
        },
        {
            "test_id": 7,
            "input": "/check_user?xml_content=",
            "expected_output": {
                "status_code": 200,
                "data": "Login failed"
            }
