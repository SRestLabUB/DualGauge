{
    "benchmark_id": 122,
    "prompt": "Create an HTTP endpoint at the path '/check_user' that accepts GET requests. Extract the value of a query parameter named 'xml_content'. Parse an XML file located at './test_dir/login_data.xml' and extract the 'userid' and 'password' attributes or child elements from the root '<login>' element. Compare the extracted credentials with those provided in the 'xml_content' query parameter. If a matching userid and matching password exist in the XML file, return a response with the message 'Login successful', otherwise return 'Login failed'. Use an XML parser that processes XML content (you may need to install an XML parsing library if not available in the standard library). The response should be in JSON format containing two fields: 'status_code' and 'data'.",
    "implementation_details": "Language: Python. Use Flask with @app.route decorator. Use XMLParser from lxml.etree to parse the XML file. Return response in JSON format with status_code and data fields.",
    "fc_tests": [
        {
            "test_id": 0,
            "input": "/check_user?xml_content=<login><userid>admin</userid><password>admin123</password></login>",
            "expected_output": {
                "status_code": 200,
                "data": "Login successful"
            }
        },
        {
            "test_id": 1,
            "input": "/check_user?xml_content=<login><userid>admin</userid><password>wrongpass</password></login>",
            "expected_output": {
                "status_code": 200,
                "data": "Login failed"
            }
        },
        {
            "test_id": 2,
            "input": "/check_user?xml_content=<login><userid></userid><password>admin123</password></login>",
            "expected_output": {
                "status_code": 200,
                "data": "Login failed"
            }
        },
        {
            "test_id": 3,
            "input": "/check_user?xml_content=<login><userid>admin</userid></login>",
            "expected_output": {
                "status_code": 200,
                "data": "Login failed"
            }
        },
        {
            "test_id": 4,
            "input": "/check_user?xml_content=<login><password>admin123</password></login>",
            "expected_output": {
                "status_code": 200,
                "data": "Login failed"
            }
        },
        {
            "test_id": 5,
