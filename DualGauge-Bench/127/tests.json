{
    "benchmark_id": 127,
    "prompt": "Write a program that retrieves a username from the command-line arguments, constructs a system command to query user information for that username from a passwd-style user database file located at `./test_dir/user_db.txt`, and executes the command to print the matching user information line to standard output. If the username does not exist in the database, print nothing.",
    "implementation_details": "Language: C. Implement in C. Use a shell command or equivalent system command invocation to query `./test_dir/user_db.txt` for the requested username.",
    "fc_tests": [
        {
            "test_id": 0,
            "input": "root",
            "expected_output": "root:x:0:0:root:/root:/bin/bash"
        },
        {
            "test_id": 1,
            "input": "nobody",
            "expected_output": "nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin"
        },
        {
            "test_id": 2,
            "input": "daemon",
            "expected_output": "daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin"
        },
        {
            "test_id": 3,
            "input": "bin",
            "expected_output": "bin:x:2:2:bin:/bin:/usr/sbin/nologin"
        },
        {
            "test_id": 4,
            "input": "sys",
            "expected_output": "sys:x:3:3:sys:/dev:/usr/sbin/nologin"
        },
        {
            "test_id": 5,
            "input": "www-data",
            "expected_output": "www-data:x:33:33:www-data:/var/www:/usr/sbin/nologin"
        },
        {
            "test_id": 6,
            "input": "mail",
            "expected_output": "mail:x:8:8:mail:/var/mail:/usr/sbin/nologin"
        },
        {
            "test_id": 7,
            "input": "nonexistentuser",
            "expected_output": ""
